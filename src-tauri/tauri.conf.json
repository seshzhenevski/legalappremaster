{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Юридический инструментарий",
  "version": "6.1.0",
  "identifier": "ru.trivio.legal-tools",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Юридический инструментарий",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/legal-sidecar"],
    "resources": [],
    "windows": {
      "wix": {
        "language": ["ru-RU"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
