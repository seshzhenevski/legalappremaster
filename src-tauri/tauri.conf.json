{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legal App (база знаний)",
  "version": "6.3.2-kb1",
  "identifier": "ru.trivio.legal-tools.kb",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Legal App — прототип базы знаний",
        "width": 1400,
        "height": 820,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/legal-sidecar"],
    "resources": [],
    "windows": {
      "wix": {
        "language": ["ru-RU"]
      }
    }
  },
  "plugins": {
    "shell": {
      "_комментарий": "Открытие ограничено http и https: статьи базы знаний правят все пользователи, и открывать по клику произвольный файл с сетевой папки приложение не должно.",
      "open": "^https?://"
    }
  }
}
