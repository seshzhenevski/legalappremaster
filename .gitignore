# Node
node_modules/

# Rust build output
src-tauri/target/
src-tauri/gen/

# Собранный sidecar-бинарник (пересобирается через npm run build:sidecar)
src-tauri/binaries/*.exe

# Артефакты PyInstaller
build-sidecar/
dist-sidecar/

# Собранный Tailwind CSS (пересобирается через npm run build:css)
src/css/tailwind.css

# Python
__pycache__/
*.pyc
*.log

# Рабочий реестр отправленных претензий — живые данные контрагентов, в него
# пишет само приложение (путь к папке указывается в интерфейсе). В репозитории
# не хранится.
ОТПРАВКИ ПРЕТЕНЗИЙ.xlsx

# Ключ сервисного аккаунта Google для дашборда. Это секрет: с ним читается
# рабочая таблица юротдела. В репозиторий и в собранный .exe не попадает —
# лежит только на диске пользователя, путь к нему указывается в настройках.
sheets-*.json
*service-account*.json
*-key.json

# Выгрузка рабочей таблицы (живые данные контрагентов) — только для сверки.
Trivio Legal.xlsx

# Факсимиле подписи и печати — приватные данные, в репозиторий не попадают.
# Приложение читает их только как base64 из legal_tools/assets/embedded.py,
# файлы на диске кодом не используются.
signature.jpg
stamp.jpg

# Иконки мобильных платформ и macOS, которые генерирует `npm run tauri icon`.
# Сборка Windows-only (targets: nsis, msi) использует только icons/32x32.png,
# icons/128x128.png и icons/icon.ico — остальное не коммитим.
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/*.icns
src-tauri/icons/Square*
src-tauri/icons/StoreLogo.png

# Отчёты Совета LLM — рабочие документы аудита, не для публикации.
council-*.md
council-*.html

# Референс-компонент dark-mode-toggle (сторонний, для образца UI переключателя
# темы) — в репозиторий приложения не входит.
dark-mode-toggle-master/

# ОС/редактор
.DS_Store
Thumbs.db
